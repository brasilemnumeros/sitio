---
// Portado do `404.html` do site antigo (fatia 02/T3). Deixa de apontar para o
// `layout: page` inexistente (achado da ADR 0001) e passa a usar o `Base.astro`.
//
// O corpo era em INGLÊS no site publicado (resíduo de template: "Page not found :(").
// Decisão do usuário em 2026-10-18: traduzir — o inglês é defeito visível, não estilo.
// O link de volta para `/` também é adição deliberada (o original não tinha nenhum).
//
// O 404 NÃO tem título de página: publica o título do SITE. `tituloDoSite` faz o
// `Meta` emitir `<title>` = `Brasil em Números | <tagline>` (medido no publicado).
// O `title` abaixo é o título do site; o `Base` o exige e o `Meta` o usa como
// `og:title`. A `description` é a do site.
import Base from '../layouts/Base.astro';
import { SITE } from '../config.js';
---

<Base title={SITE.nome} description={SITE.descricao} tituloDoSite>
  {/* `is:inline`: o `<style>` é VERBATIM do site antigo. Sem ele, o Astro escopa o CSS
      (acrescenta atributo aos seletores e aos elementos) e o `.container`/`h1`
      deixariam de casar — o corpo perderia o estilo em silêncio. */}
  <style is:inline type="text/css" media="screen">
    .container {
      margin: 10px auto;
      max-width: 600px;
      text-align: center;
    }
    h1 {
      margin: 30px 0;
      font-size: 4em;
      line-height: 1;
      letter-spacing: -1px;
    }
  </style>

  <div class="container">
    <h1>404</h1>

    <p><strong>Página não encontrada :(</strong></p>
    <p>A página que você procura não existe ou foi movida.</p>

    <p><a href="/">Voltar para a página inicial</a></p>
  </div>
</Base>
